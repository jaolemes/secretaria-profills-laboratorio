          "name": "conector_problema_so_em_atencao",
          "value": "(\"conector\".\"fase\" = 'atencao') = (\"conector\".\"codigo_problema\" IS NOT NULL)"
        },
        "conector_conectado_verificado": {
          "name": "conector_conectado_verificado",
          "value": "\"conector\".\"fase\" <> 'conectado' OR \"conector\".\"verificado_em\" IS NOT NULL"
        },
        "conector_conectado_com_identidade": {
          "name": "conector_conectado_com_identidade",
          "value": "\"conector\".\"fase\" <> 'conectado' OR \"conector\".\"id\" = 'crm' OR \"conector\".\"identidade\" IS NOT NULL"
        },
        "conector_email_com_config": {
          "name": "conector_email_com_config",
          "value": "\"conector\".\"id\" <> 'email' OR \"conector\".\"fase\" <> 'conectado' OR \"conector\".\"config\" IS NOT NULL"
        },
        "conector_crm_com_prazo": {
          "name": "conector_crm_com_prazo",
          "value": "\"conector\".\"id\" <> 'crm' OR \"conector\".\"fase\" <> 'conectado' OR \"conector\".\"conexao_expira_em\" IS NOT NULL"
        }
